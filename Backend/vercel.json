{
    "version": 2,
    "builds": [
        {
            "src": "Index.js",
            "use": "@vercel/node"
        }
    ],
    "routes": [
        {
            "src": "/(.*)",
            "dest": "Index.js"
        }
    ],
    "crons": [
        {
            "path": "/api/quotation/db-health",
            "schedule": "*/5 * * * *"
        }
    ]
}
